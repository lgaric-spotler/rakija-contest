{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null && auth.token.email == 'rakija-admin@rakija.example.com'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !data.exists()",
        ".validate": "newData.hasChildren(['name', 'pin'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        },
        "pin": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{6}$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "judges": {
      ".read": "auth != null && auth.token.email == 'rakija-admin@rakija.example.com'",
      ".write": "auth != null && auth.token.email == 'rakija-admin@rakija.example.com'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".validate": "newData.val() === true"
      }
    },
    "state": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email == 'rakija-admin@rakija.example.com'",
      ".validate": "newData.hasChildren(['locked', 'n', 'open'])",
      "locked": {
        ".validate": "newData.isBoolean()"
      },
      "n": {
        ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20 && newData.val() % 1 === 0"
      },
      "open": {
        ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 20 && newData.val() % 1 === 0"
      },
      "openRounds": {
        "$r": {
          ".validate": "newData.isBoolean()"
        }
      },
      "$other": {
        ".validate": false
      }
    },
    "admin": {
      ".read": "auth != null && auth.token.email == 'rakija-admin@rakija.example.com'",
      ".write": "auth != null && auth.token.email == 'rakija-admin@rakija.example.com'"
    },
    "ratings": {
      ".read": "auth != null && auth.token.email == 'rakija-admin@rakija.example.com'",
      ".write": "auth != null && auth.token.email == 'rakija-admin@rakija.example.com'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$r": {
          ".write": "auth != null && auth.uid === $uid && root.child('judges').child(auth.uid).exists() && root.child('state/locked').val() === true && root.child('state/openRounds').child($r).val() === true && (!data.exists() || data.child('locked').val() !== true)",
          ".validate": "newData.hasChild('locked') && (newData.child('locked').val() !== true || (newData.child('c/0').exists() && newData.child('c/1').exists() && newData.child('c/2').exists() && newData.child('c/3').exists()))",
          "locked": {
            ".validate": "newData.isBoolean()"
          },
          "c": {
            "$k": {
              ".validate": "$k.matches(/^[0-3]$/) && newData.isNumber() && newData.val() >= 1 && newData.val() <= 10 && newData.val() % 1 === 0"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "pub": {
      ".write": "auth != null && auth.token.email == 'rakija-admin@rakija.example.com'",
      "finale": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email == 'rakija-admin@rakija.example.com'"
      },
      "rounds": {
        ".read": "auth != null && (auth.token.email == 'rakija-admin@rakija.example.com' || !root.child('judges').child(auth.uid).exists())",
        ".write": "auth != null && auth.token.email == 'rakija-admin@rakija.example.com'"
      }
    },
    "quiz": {
      ".read": false,
      ".write": false,
      "state": {
        ".read": "auth != null && (auth.token.email == 'rakija-admin@rakija.example.com' || root.child('quizHosts').child(auth.uid).exists())",
        ".write": "auth != null && (auth.token.email == 'rakija-admin@rakija.example.com' || root.child('quizHosts').child(auth.uid).exists())",
        ".validate": "newData.hasChildren(['json','rev']) && newData.child('json').isString() && newData.child('json').val().length < 500000"
      },
      "preReplace": {
        ".read": "auth != null && (auth.token.email == 'rakija-admin@rakija.example.com' || root.child('quizHosts').child(auth.uid).exists())",
        ".write": "auth != null && (auth.token.email == 'rakija-admin@rakija.example.com' || root.child('quizHosts').child(auth.uid).exists())",
        ".validate": "newData.hasChildren(['json','rev']) && newData.child('json').isString() && newData.child('json').val().length < 500000"
      },
      "bak": {
        ".read": "auth != null && (auth.token.email == 'rakija-admin@rakija.example.com' || root.child('quizHosts').child(auth.uid).exists())",
        ".write": "auth != null && (auth.token.email == 'rakija-admin@rakija.example.com' || root.child('quizHosts').child(auth.uid).exists())",
        ".validate": "newData.hasChildren(['json','rev']) && newData.child('json').isString() && newData.child('json').val().length < 500000"
      },
      "catalog": {
        ".read": "auth != null && (auth.token.email == 'rakija-admin@rakija.example.com' || root.child('quizHosts').child(auth.uid).exists())",
        ".write": "auth != null && auth.token.email == 'rakija-admin@rakija.example.com'",
        ".validate": "newData.hasChildren(['qa','catalog'])"
      }
    },
    "quizHosts": {
      ".read": "auth != null && auth.token.email == 'rakija-admin@rakija.example.com'",
      ".write": "auth != null && auth.token.email == 'rakija-admin@rakija.example.com'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".validate": "newData.val() === true"
      }
    }
  }
}
